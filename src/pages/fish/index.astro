---
import Base from "../../layouts/Base.astro";
import fish from "../../data/fish.json";

import Related from "../../components/Related.astro";
import recipes from "../../data/recipes.json";
import { slugify, splitDishTitles } from "../../lib/diverdb.js";
const dishTitles = new Set(recipes.map((r) => r.title));
const zones = [...new Set(fish.flatMap((f) => f.categories || []))]
  .filter((z) => z && !["Fish", "Bosses"].includes(z))
  .sort();

const times = [...new Set(fish.map((f) => f.active_time).filter(Boolean))].sort();

const sorted = [...fish].sort((a, b) => Number(a.rank || 999) - Number(b.rank || 999));
const listSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Dave the Diver Fish Database",
  itemListElement: fish.slice(0, 20).map((f, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: f.title,
  })),
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "What is the best fish to farm in Dave the Diver?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Use the Fish Farm Planner to rank species by meat per day and breeding rate before choosing ranch stock.",
      },
    },
    {
      "@type": "Question",
      name: "Why do fish appear in multiple zones?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Many Dave the Diver fish can appear in more than one Blue Hole zone and at different active times.",
      },
    },
    {
      "@type": "Question",
      name: "How do I find nocturnal fish in Dave the Diver?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Complete A Noisy Customer to unlock night diving, then filter this database by the night active time.",
      },
    },
  ],
};
---

<Base
  title="All Fish Database - Dave the Diver - DiverDB"
  description="Searchable Dave the Diver fish database: zone, rank, weight, meat yield, breeding rate, fish per day and farm value."
  schema={[listSchema, faqSchema]}
>
  <h1>Fish Database</h1>
  <p class="muted">
    Every fish and catchable creature from the Marinca database, with farming stats for ranch planning.
    Use the filters to compare active times, farm output and breeding rates before deciding what to stock.
  </p>

  <div class="card" style="display:flex;gap:1rem;flex-wrap:wrap;align-items:end">
    <label style="flex:1;min-width:180px">
      Search
      <input id="q" type="search" placeholder="e.g. Bluefin Tuna" style="display:block;width:100%;margin-top:0.3rem" />
    </label>
    <label style="min-width:180px">
      Zone
      <select id="zone" style="display:block;width:100%;margin-top:0.3rem">
        <option value="">All zones</option>
        {zones.map((z) => <option value={z}>{z}</option>)}
      </select>
    </label>
    <label style="min-width:160px">
      Active time
      <select id="time" style="display:block;width:100%;margin-top:0.3rem">
        <option value="">Any time</option>
        {times.map((t) => <option value={t}>{t}</option>)}
      </select>
    </label>
  </div>

  <div style="margin-top:1rem;overflow-x:auto">
    <table id="fish-table">
      <thead>
        <tr>
          <th data-key="title">Fish</th>
          <th data-key="rank" data-numeric="true">Rank</th>
          <th>Zone</th>
          <th>Time</th>
          <th data-key="weight">Weight</th>
          <th data-key="meat_per_day" data-numeric="true">Meat / day</th>
          <th data-key="farm_meat_avg" data-numeric="true">Farm avg</th>
          <th data-key="breed_rate">Breed rate</th>
          <th>Used in</th>
        </tr>
      </thead>
      <tbody>
        {sorted.map((f) => {
          const zone = (f.categories || []).find((c) => c !== "Fish" && c !== "Bosses") || f.source || "Unknown";
          return (
            <tr data-name={(f.title || "").toLowerCase()} data-zone={zone} data-time={f.active_time || ""}>
              <td><a href={`/fish/${slugify(f.title)}/`}><strong>{f.title}</strong></a></td>
              <td>{f.rank || "—"}</td>
              <td>{zone}</td>
              <td>{f.active_time || "—"}</td>
              <td>{f.weight || "—"}</td>
              <td>{f.meat_per_day || "—"}</td>
              <td>{f.farm_meat_avg || "—"}</td>
              <td>{f.breed_rate || "—"}</td>
              <td style="max-width:240px">
                {splitDishTitles(f.recipes, dishTitles).map((d) =>
                  dishTitles.has(d) ? (
                    <a href={`/recipes/${slugify(d)}/`} style="display:block">{d}</a>
                  ) : (
                    <span class="muted">{d}</span>
                  )
                )}
                {!f.recipes && "—"}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <script is:inline>
    const q = document.getElementById("q");
    const zone = document.getElementById("zone");
    const time = document.getElementById("time");
    const table = document.getElementById("fish-table");
    const tbody = table.querySelector("tbody");
    const headers = table.querySelectorAll("th[data-key]");
    const rows = Array.from(tbody.querySelectorAll("tr"));

    function render() {
      const query = q.value.trim().toLowerCase();
      rows.forEach((row) => {
        const matchQ = !query || row.dataset.name.includes(query);
        const matchZone = !zone.value || row.dataset.zone === zone.value;
        const matchTime = !time.value || row.dataset.time === time.value;
        row.style.display = matchQ && matchZone && matchTime ? "" : "none";
      });
    }

    headers.forEach((th) => {
      let asc = true;
      th.style.cursor = "pointer";
      th.addEventListener("click", () => {
        const key = th.dataset.key;
        const numeric = th.dataset.numeric === "true";
        const visible = rows.filter((r) => r.style.display !== "none");
        visible.sort((a, b) => {
          const av = a.querySelector(`td:nth-child(${Array.from(headers).indexOf(th) + 1})`).textContent.trim();
          const bv = b.querySelector(`td:nth-child(${Array.from(headers).indexOf(th) + 1})`).textContent.trim();
          const na = Number(av) || 0;
          const nb = Number(bv) || 0;
          const result = numeric ? na - nb : av.localeCompare(bv);
          return asc ? result : -result;
        });
        visible.forEach((r) => tbody.appendChild(r));
        asc = !asc;
      });
    });

    q.addEventListener("input", render);
    zone.addEventListener("change", render);
    time.addEventListener("change", render);
  </script>

  <section>
    <h2>Fishing data FAQ</h2>
    <div class="card" style="margin-bottom:0.75rem">
      <h3 style="margin:0 0 0.25rem">What is the best fish to farm?</h3>
      <p style="margin:0">Rank candidates by meat per day and breeding rate in the Fish Farm Planner before choosing ranch stock.</p>
    </div>
    <div class="card" style="margin-bottom:0.75rem">
      <h3 style="margin:0 0 0.25rem">Why do fish appear in multiple zones?</h3>
      <p style="margin:0">Many fish can appear in more than one Blue Hole zone and at different active times.</p>
    </div>
    <div class="card" style="margin-bottom:0.75rem">
      <h3 style="margin:0 0 0.25rem">How do I find nocturnal fish?</h3>
      <p style="margin:0">Unlock night diving through A Noisy Customer, then filter this database by the night active time.</p>
    </div>
  </section>

  <Related
    heading="Next steps"
    links={[
    { href: "/tools/fish-farm/", title: "Fish Farm Planner", sub: "Rank fish by meat per day for your ranch", tool: true },
    { href: "/tools/recipe-filter/", title: "Recipe Filter", sub: "Find dishes by ingredient and taste", tool: true },
    { href: "/rankings/", title: "Rankings", sub: "Best fish, dishes and staff ranked", tool: true },
  ]}
  />
</Base>
