---
import Base from "../../layouts/Base.astro";

import Related from "../../components/Related.astro";
const guides = [
  { title: "Beginner Roadmap", desc: "First-day upgrades, money loop and what to keep.", href: "/guides/beginner/" },
  { title: "Best Fish for Early Game", desc: "Shallow-water producers that feed the early menu.", href: "/guides/best-fish-early-game/" },
  { title: "Fish Farm Unlock", desc: "A Noisy Customer and Otto's farm tanks.", href: "/guides/fish-farm-unlock/" },
  { title: "Tuna Party & Salvage Drone", desc: "When tuna appears and how to move big catches.", href: "/guides/tuna-party-salvage-drone/" },
  { title: "Best Fish to Farm", desc: "Ranch strategy backed by meat-per-day data.", href: "/guides/fish-farming/" },
  { title: "Recipe Economy", desc: "How price, taste and dish count shape the menu.", href: "/guides/recipe-economy/" },
  { title: "Best Dishes by Rank", desc: "Top recipes for each Cooksta rank.", href: "/guides/best-dishes/" },
  { title: "Staff Training", desc: "Hiring, training and role assignment.", href: "/guides/staff-training/" },
  { title: "Staff Unlocks", desc: "Recruitment and training priority.", href: "/guides/staff-unlocks/" },
  { title: "Weapon Progression", desc: "Early to late dive loadouts.", href: "/guides/weapon-progression/" },
  { title: "Weapon Upgrade Materials", desc: "Duff, iDiver and upgrade order.", href: "/guides/weapon-upgrade-materials/" },
  { title: "Boss Order", desc: "Boss encounters by zone and their rewards.", href: "/guides/boss-order/" },
  { title: "Marinca Collection", desc: "Fish cards and Marinca Bloom.", href: "/guides/marinca-collection/" },
  { title: "Night Diving", desc: "Unlock night dives and target nocturnal fish.", href: "/guides/night-diving/" },
  { title: "In the Jungle DLC", desc: "Sato, Marinca Bloom and the flower.", href: "/guides/jungle-dlc/" },
  { title: "Achievement Guide", desc: "Full achievement checklist strategy.", href: "/guides/achievements/" },
  { title: "FAQ", desc: "Fast answers to common questions.", href: "/guides/faq/" },
];
---

<Base
  title="Dave the Diver Guides - DiverDB"
  description="Dave the Diver guides: beginner roadmap, fish farming, recipe economy, staff training, weapon progression and boss order."
>
  <h1>Guides</h1>
  <div class="grid grid-3">
    {guides.map((g) => (
      <a class="card" href={g.href} style="display:block;color:inherit">
        <h3 style="margin:0 0 0.25rem">{g.title}</h3>
        <p class="muted" style="margin:0;font-size:0.92rem">{g.desc}</p>
      </a>
    ))}
  </div>

  <Related
    heading="Next steps"
    links={[
    { href: "/rankings/", title: "Rankings", sub: "Best fish, dishes, staff and weapons ranked", tool: true },
    { href: "/tools/", title: "Tools", sub: "Planner, filter and compare utilities", tool: true },
  ]}
  />
</Base>
