---
import Base from "../../layouts/Base.astro";
import recipes from "../../data/recipes.json";

import Related from "../../components/Related.astro";
import fish from "../../data/fish.json";
import { slugify, parseIngredients } from "../../lib/diverdb.js";
const fishTitles = new Set(fish.map((f) => f.title));
const sorted = [...recipes].sort((a, b) => Number(b.maxtaste || 0) - Number(a.maxtaste || 0));
const maxPrice = Math.max(...recipes.map((r) => Number(r.maxprice) || 0));
const maxTaste = Math.max(...recipes.map((r) => Number(r.maxtaste) || 0));
const listSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Dave the Diver Recipe Database",
  itemListElement: recipes.slice(0, 20).map((r, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: r.title,
  })),
};
---

<Base
  title="Recipe Database - Dave the Diver - DiverDB"
  description="Searchable Dave the Diver recipe database: ingredients, base and max price, taste, dish count and upgrade value."
  schema={listSchema}
>
  <h1>Recipe Database</h1>
  <p class="muted">
    Compare every recipe by ingredient cost, taste, price and dish count to plan the daily menu.
  </p>

  <div class="stats" style="margin:1rem 0">
    <div class="stat"><strong>{recipes.length}</strong><span>Recipes</span></div>
    <div class="stat"><strong>{maxPrice}</strong><span>Highest max price</span></div>
    <div class="stat"><strong>{maxTaste}</strong><span>Highest max taste</span></div>
  </div>

  <div class="card" style="display:flex;gap:1rem;flex-wrap:wrap;align-items:end">
    <label style="flex:1;min-width:200px">
      Search
      <input id="q" type="search" placeholder="e.g. Tuna Sushi" style="display:block;width:100%;margin-top:0.3rem" />
    </label>
    <label style="min-width:180px">
      Min max taste
      <input id="minTaste" type="number" min="0" max={maxTaste} style="display:block;width:100%;margin-top:0.3rem" />
    </label>
  </div>

  <div style="margin-top:1rem;overflow-x:auto">
    <table id="recipe-table">
      <thead>
        <tr>
          <th data-key="title">Recipe</th>
          <th>Ingredients</th>
          <th data-key="baseprice" data-numeric="true">Base price</th>
          <th data-key="maxprice" data-numeric="true">Max price</th>
          <th data-key="basetaste" data-numeric="true">Base taste</th>
          <th data-key="maxtaste" data-numeric="true">Max taste</th>
          <th data-key="maxdish" data-numeric="true">Max dish</th>
        </tr>
      </thead>
      <tbody>
        {sorted.map((r) => (
          <tr data-name={(r.title || "").toLowerCase()} data-taste={Number(r.maxtaste) || 0}>
            <td><a href={`/recipes/${slugify(r.title)}/`}><strong>{r.title}</strong></a></td>
            <td style="max-width:280px">
              {parseIngredients(r.ingredients).map((i) =>
                fishTitles.has(i.name) ? (
                  <a href={`/fish/${slugify(i.name)}/`} style="display:block">{i.qty} {i.name}</a>
                ) : (
                  <span class="muted" style="display:block">{i.qty} {i.name}</span>
                )
              )}
              {!r.ingredients && "—"}
            </td>
            <td>{r.baseprice || "—"}</td>
            <td>{r.maxprice || "—"}</td>
            <td>{r.basetaste || "—"}</td>
            <td>{r.maxtaste || "—"}</td>
            <td>{r.maxdish || "—"}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <script is:inline>
    const q = document.getElementById("q");
    const minTaste = document.getElementById("minTaste");
    const table = document.getElementById("recipe-table");
    const tbody = table.querySelector("tbody");
    const headers = table.querySelectorAll("th[data-key]");
    const rows = Array.from(tbody.querySelectorAll("tr"));

    function render() {
      const query = q.value.trim().toLowerCase();
      const min = Number(minTaste.value) || 0;
      rows.forEach((row) => {
        const matchQ = !query || row.dataset.name.includes(query);
        const matchTaste = Number(row.dataset.taste) >= min;
        row.style.display = matchQ && matchTaste ? "" : "none";
      });
    }

    headers.forEach((th) => {
      let asc = true;
      th.style.cursor = "pointer";
      th.addEventListener("click", () => {
        const numeric = th.dataset.numeric === "true";
        const visible = rows.filter((r) => r.style.display !== "none");
        visible.sort((a, b) => {
          const index = Array.from(headers).indexOf(th) + 1;
          const av = a.querySelector(`td:nth-child(${index})`).textContent.trim();
          const bv = b.querySelector(`td:nth-child(${index})`).textContent.trim();
          const result = numeric ? (Number(av) || 0) - (Number(bv) || 0) : av.localeCompare(bv);
          return asc ? result : -result;
        });
        visible.forEach((r) => tbody.appendChild(r));
        asc = !asc;
      });
    });

    q.addEventListener("input", render);
    minTaste.addEventListener("input", render);
  </script>

  <Related
    heading="Next steps"
    links={[
    { href: "/tools/recipe-filter/", title: "Recipe Filter", sub: "Find dishes by ingredient and taste", tool: true },
    { href: "/rankings/", title: "Rankings", sub: "Dishes ranked by profit and taste", tool: true },
    { href: "/tools/fish-farm/", title: "Fish Farm Planner", sub: "Never run out of ingredients", tool: true },
  ]}
  />
</Base>
