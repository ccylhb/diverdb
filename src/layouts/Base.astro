---
interface Props {
  title: string;
  description: string;
  schema?: object | string;
}

const { title, description, schema } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const siteUrl = Astro.site?.href || "https://diverdb.pages.dev/";
const defaultSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "DiverDB",
  url: siteUrl,
  description: "Dave the Diver fish, recipe, staff, weapon and boss database.",
};
const extraSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const schemas = [defaultSchema, ...extraSchemas];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3245910354455258" crossorigin="anonymous"></script>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="DiverDB" />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#11191d" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🐟</text></svg>" />
    {
      schemas.map((s) => (
        <script type="application/ld+json" set:html={typeof s === "string" ? s : JSON.stringify(s)} />
      ))
    }
    <style is:global>
      :root {
        --bg: #11191d;
        --bg-soft: #182329;
        --card: #1e2b31;
        --border: #2d4149;
        --text: #e7eef1;
        --muted: #9aacb3;
        --accent: #ff7a59;
        --accent-2: #3fd6c4;
        --amber: #f4c95d;
        --good: #7bd88f;
        --bad: #f26d6d;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
        line-height: 1.6;
        letter-spacing: 0;
      }
      a { color: var(--accent-2); text-decoration: none; }
      a:hover { text-decoration: underline; }
      header.site-header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: rgba(17, 25, 29, 0.94);
        backdrop-filter: blur(6px);
        border-bottom: 1px solid var(--border);
      }
      .header-inner {
        max-width: 1160px;
        margin: 0 auto;
        padding: 0.75rem 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .brand { font-size: 1.25rem; font-weight: 700; color: var(--text); letter-spacing: 0; }
      .brand span { color: var(--accent); }
      nav.main-nav { display: flex; gap: 0.35rem; flex-wrap: wrap; }
      nav.main-nav a {
        color: var(--muted);
        padding: 0.35rem 0.65rem;
        border-radius: 8px;
        font-size: 0.9rem;
        white-space: nowrap;
      }
      nav.main-nav a:hover { color: var(--text); background: var(--bg-soft); text-decoration: none; }
      main { max-width: 1160px; margin: 0 auto; padding: 1.5rem 1rem 3rem; }
      footer.site-footer {
        border-top: 1px solid var(--border);
        padding: 1.5rem 1rem;
        color: var(--muted);
        font-size: 0.85rem;
        text-align: center;
      }
      .footer-links {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.5rem 1rem;
        margin-bottom: 0.75rem;
      }
      .footer-links a { color: var(--muted); }
      .footer-links a:hover { color: var(--text); }
      h1 { font-size: 2.1rem; margin: 0 0 0.5rem; line-height: 1.2; }
      h2 { margin: 2rem 0 0.75rem; font-size: 1.45rem; line-height: 1.25; }
      h3 { margin: 1.5rem 0 0.5rem; font-size: 1.08rem; line-height: 1.3; }
      p { margin: 0.6rem 0; }
      .card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 1.1rem 1.15rem;
      }
      .grid { display: grid; gap: 1rem; }
      .grid-3 { grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); }
      .grid-2 { grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); }
      .tag {
        display: inline-block;
        background: var(--bg-soft);
        border: 1px solid var(--border);
        color: var(--accent-2);
        border-radius: 999px;
        padding: 0.12rem 0.55rem;
        font-size: 0.76rem;
        font-weight: 600;
        letter-spacing: 0;
      }
      .tag.hot { color: var(--accent); }
      table {
        width: 100%;
        border-collapse: collapse;
        background: var(--card);
        border-radius: 8px;
        overflow: hidden;
        font-size: 0.9rem;
      }
      th, td { padding: 0.55rem 0.7rem; text-align: left; border-bottom: 1px solid var(--border); vertical-align: top; }
      th { background: var(--bg-soft); color: var(--muted); font-weight: 600; white-space: nowrap; }
      tr:last-child td { border-bottom: none; }
      input, select, button {
        font: inherit;
        color: var(--text);
        background: var(--bg-soft);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 0.5rem 0.75rem;
      }
      button { background: var(--accent); color: #11191d; font-weight: 600; cursor: pointer; }
      button:hover { filter: brightness(1.08); }
      .muted { color: var(--muted); }
      .notice {
        background: #2a2518;
        border: 1px solid #57452a;
        border-radius: 8px;
        padding: 0.85rem 1rem;
        font-size: 0.92rem;
      }
      .toc { background: var(--bg-soft); border: 1px solid var(--border); border-radius: 8px; padding: 1rem 1.25rem; }
      .toc ul { margin: 0.4rem 0 0; padding-left: 1.2rem; }
      .related-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.75rem; }
      a.related-card {
        display: flex; align-items: center; gap: 0.7rem;
        background: var(--card); border: 1px solid var(--border); border-radius: 10px;
        padding: 0.7rem 0.85rem; color: inherit;
        transition: border-color 0.15s ease, transform 0.15s ease;
      }
      a.related-card:hover { border-color: var(--accent); transform: translateY(-2px); text-decoration: none; }
      a.related-card img { width: 38px; height: 38px; object-fit: contain; flex: none; }
      a.related-card .rc-title { font-weight: 600; font-size: 0.95rem; }
      a.related-card .rc-sub { color: var(--muted); font-size: 0.82rem; }
      a.related-card.tool-card {
        border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
        background: color-mix(in srgb, var(--accent) 10%, var(--card));
      }
      a.related-card.tool-card .rc-badge {
        display: inline-block; background: var(--accent); color: var(--bg);
        border-radius: 999px; padding: 0.05rem 0.5rem; font-size: 0.7rem; font-weight: 700;
        margin-left: 0.4rem; vertical-align: middle;
      }
      nav.main-nav a.navtool {
        color: var(--accent);
        border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
      }
      .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.75rem; }
      .stat { border-left: 3px solid var(--accent-2); padding-left: 0.75rem; }
      .stat strong { display: block; font-size: 1.35rem; color: var(--text); }
      .stat span { color: var(--muted); font-size: 0.85rem; }
      code, pre {
        font-family: Consolas, "Courier New", monospace;
        background: var(--bg-soft);
        border-radius: 6px;
      }
      code { padding: 0.1rem 0.35rem; font-size: 0.9em; }
      pre { padding: 1rem; overflow-x: auto; }
      pre code { padding: 0; background: none; }
      @media (max-width: 720px) {
        h1 { font-size: 1.7rem; }
        .grid-2 { grid-template-columns: 1fr; }
        nav.main-nav a { white-space: normal; }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/">Diver<span>DB</span></a>
        <nav class="main-nav">
          <a href="/">Home</a>
          <a class="navtool" href="/rankings/">Rankings</a>
          <a class="navtool" href="/tools/">Tools</a>
          <a href="/fish/">Fish</a>
          <a href="/recipes/">Recipes</a>
          <a href="/staff/">Staff</a>
          <a href="/weapons/">Weapons</a>
          <a href="/bosses/">Bosses</a>
          <a href="/guides/">Guides</a>
          <a href="/about/">About</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-links">
        <a href="/fish/">Fish</a>
        <a href="/recipes/">Recipes</a>
        <a href="/staff/">Staff</a>
        <a href="/weapons/">Weapons</a>
        <a href="/bosses/">Bosses</a>
        <a href="/tools/">Tools</a>
        <a href="/guides/">Guides</a>
        <a href="/sitemap/">All Pages</a>
        <a href="/about/">About</a>
        <a href="/privacy-policy/">Privacy</a>
      </div>
      <p>
        DiverDB is an unofficial fan resource. Dave the Diver is a trademark of MINTROCKET.
        Game data is for informational purposes only.
      </p>
    </footer>
  </body>
</html>
